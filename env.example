# ============================================
# OpenTelemetry Configuration for Grafana Cloud
# ============================================
# Copy this file to .env and fill in your actual values from Grafana Cloud

# Service Configuration
# ---------------------
# Name of your service (will appear in Grafana Cloud)
OTEL_SERVICE_NAME=observability-lab-service

# Version of your service
OTEL_SERVICE_VERSION=1.0.0

# Deployment environment (development, staging, production)
OTEL_ENVIRONMENT=development

# Grafana Cloud OTLP Endpoint
# ----------------------------
# The base endpoint URL for sending OTLP data to Grafana Cloud
# Format: https://otlp-gateway-<region>.grafana.net/otlp
# Example: https://otlp-gateway-prod-us-central-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net/otlp

# Authentication Headers
# ----------------------
# Headers for authenticating with Grafana Cloud
# Format: Authorization=Basic <base64(instanceId:apiKey)>
# You can get this from Grafana Cloud → Connections → OpenTelemetry
# 
# The Basic auth token is base64 encoded: instanceId:apiKey
# Example: Authorization=Basic MTIzNDU2OmFiY2RlZmdoaWprbG1ub3BxcnN0dXZ3eHl6
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic YOUR_BASE64_ENCODED_CREDENTIALS_HERE

# Optional: OTLP Protocol (default is http/protobuf)
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Grafana Cloud Loki Configuration (for Logs)
# --------------------------------------------
# These are OPTIONAL - if not set, logs will only print to console
# To enable log shipping to Grafana Cloud Loki, get these from:
# Grafana Cloud → Connections → Data sources -> Loki data source
# 
# Loki endpoint URL (format: https://logs-prod-<region>.grafana.net)
# Example: LOKI_HOST=https://logs-prod-us-central1.grafana.net
LOKI_HOST=

# Your Grafana Cloud instance ID (numeric value shown in Loki data source as "User")
# Example: LOKI_USER=123456
LOKI_USER=

# API key with logs:write permission
# Grafana Cloud → Administration → Users and access -> Cloud access Policies
# Create a new policy with logs:write permission
# Click on "Add token". Create the token and copy it. It's your new LOKI_API_KEY
# Example: LOKI_API_KEY=glc_eyJrIjoiYWJjZGVmZ2hpamtsbW5vcCIsIm4iOiJ0ZXN0In0=
LOKI_API_KEY=

# Server Configuration
# --------------------
# Port for the web service to listen on
PORT=3000

# Node Environment
NODE_ENV=development
